<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Supertek — Master Price List</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --blue:#1a56db;--blue-lt:#ebf0ff;--blue-dk:#1344b0;
  --green:#057a55;--green-lt:#d1fae5;
  --red:#dc2626;--red-lt:#fee2e2;
  --amber:#d97706;--amber-lt:#fef3c7;
  --text:#111827;--muted:#6b7280;--border:#e5e7eb;
  --bg:#f9fafb;--white:#fff;
  --shadow:0 1px 4px rgba(0,0,0,.08);
  --shadow-lg:0 8px 24px rgba(0,0,0,.14);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}

/* ── Header ── */
header{background:var(--blue);color:#fff;padding:18px 32px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,.2);}
.brand{display:flex;align-items:center;gap:12px;}
.logo{width:40px;height:40px;background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--blue);font-size:18px;}
header h1{font-size:20px;font-weight:700;}
header p{font-size:12px;opacity:.8;margin-top:2px;}
.header-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.badge{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.3);}
.btn-editor-login{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.4);color:#fff;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all .15s;}
.btn-editor-login:hover{background:rgba(255,255,255,.28);}
.btn-editor-logout{background:var(--red);border:none;color:#fff;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;display:none;align-items:center;gap:6px;}
.editor-active .btn-editor-login{display:none;}
.editor-active .btn-editor-logout{display:flex;}

/* ── Toolbar ── */
.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:20px 32px 0;}
.search-wrap{position:relative;flex:1;min-width:200px;max-width:380px;}
.search-wrap svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none;}
input[type="search"]{width:100%;padding:9px 12px 9px 34px;border:1px solid var(--border);border-radius:8px;font-size:14px;background:var(--white);outline:none;transition:border-color .15s;}
input[type="search"]:focus{border-color:var(--blue);}
select{padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;background:var(--white);cursor:pointer;outline:none;min-width:140px;}
select:focus{border-color:var(--blue);}
.btn{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;border:none;transition:all .15s;white-space:nowrap;}
.btn-green{background:var(--green);color:#fff;}
.btn-green:hover{background:#046040;}
.btn-blue{background:var(--blue);color:#fff;}
.btn-blue:hover{background:var(--blue-dk);}

/* ── Editor Banner ── */
.editor-banner{display:none;background:linear-gradient(135deg,#1a56db,#7c3aed);color:#fff;padding:12px 32px;font-size:14px;font-weight:600;align-items:center;gap:10px;}
.editor-active .editor-banner{display:flex;}
.editor-banner .dot{width:8px;height:8px;background:#4ade80;border-radius:50%;animation:pulse 1.5s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}

/* ── Stats ── */
.stats{display:flex;gap:14px;padding:16px 32px;flex-wrap:wrap;}
.stat{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:12px 18px;display:flex;flex-direction:column;gap:2px;min-width:130px;box-shadow:var(--shadow);}
.stat-label{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;}
.stat-value{font-size:22px;font-weight:700;}
.stat-sub{font-size:12px;color:var(--muted);}

/* ── Table ── */
.table-wrap{margin:0 32px 32px;background:var(--white);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--shadow);}
table{width:100%;border-collapse:collapse;font-size:14px;}
thead{background:#f3f4f6;}
th{padding:11px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border);cursor:pointer;user-select:none;white-space:nowrap;}
th:hover{color:var(--blue);}
th.asc::after{content:" ▲";font-size:10px;}
th.desc::after{content:" ▼";font-size:10px;}
td{padding:10px 14px;border-bottom:1px solid var(--border);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tbody tr:hover{background:var(--blue-lt);}
.sku{font-family:monospace;font-size:12px;font-weight:600;background:#f3f4f6;padding:2px 7px;border-radius:5px;color:#374151;}
.price{font-weight:700;font-size:15px;}
.cat-badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600;background:var(--blue-lt);color:var(--blue);}
.action-btns{display:none;gap:6px;}
.editor-active .action-btns{display:flex;}
.btn-edit-row{background:var(--amber-lt);color:var(--amber);border:1px solid #fcd34d;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:600;cursor:pointer;}
.btn-edit-row:hover{background:#fef9c3;}
.btn-del-row{background:var(--red-lt);color:var(--red);border:1px solid #fca5a5;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:600;cursor:pointer;}
.btn-del-row:hover{background:#fecaca;}
.no-data{text-align:center;padding:50px 20px;color:var(--muted);}
.tfoot-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-top:1px solid var(--border);background:#f9fafb;font-size:12px;color:var(--muted);flex-wrap:wrap;gap:8px;}

/* ── Editor Panel ── */
.editor-panel{display:none;margin:0 32px 24px;background:var(--white);border:2px solid var(--blue);border-radius:14px;overflow:hidden;box-shadow:var(--shadow-lg);}
.editor-active .editor-panel{display:block;}
.ep-header{background:linear-gradient(135deg,#1a56db,#7c3aed);color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;}
.ep-header h3{font-size:16px;font-weight:700;}
.ep-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);}
.ep-tab{padding:12px 20px;font-size:13px;font-weight:600;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;transition:all .15s;background:none;border-top:none;border-left:none;border-right:none;}
.ep-tab.active{color:var(--blue);border-bottom-color:var(--blue);}
.ep-tab:hover{color:var(--blue);}
.ep-body{padding:20px;}
.ep-section{display:none;}
.ep-section.active{display:block;}

/* ── Add / Edit Form ── */
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:16px;}
.form-group label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
.form-group input,.form-group select{width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;outline:none;transition:border-color .15s;}
.form-group input:focus,.form-group select:focus{border-color:var(--blue);}
.form-actions{display:flex;gap:10px;flex-wrap:wrap;}
.btn-sm{padding:8px 16px;font-size:13px;}
.btn-cancel{background:var(--bg);color:var(--text);border:1px solid var(--border);}
.btn-cancel:hover{background:#e5e7eb;}
#editNote{font-size:13px;color:var(--amber);font-weight:600;display:none;padding:8px 12px;background:var(--amber-lt);border-radius:8px;margin-bottom:12px;}

/* ── Excel Upload ── */
.drop-zone{border:2px dashed var(--border);border-radius:12px;padding:40px 20px;text-align:center;cursor:pointer;transition:all .2s;background:var(--bg);}
.drop-zone:hover,.drop-zone.drag-over{border-color:var(--blue);background:var(--blue-lt);}
.drop-zone svg{color:var(--muted);margin-bottom:12px;}
.drop-zone h4{font-size:15px;font-weight:600;margin-bottom:6px;}
.drop-zone p{font-size:13px;color:var(--muted);}
.drop-zone input{display:none;}
.upload-preview{margin-top:16px;display:none;}
.preview-table-wrap{max-height:220px;overflow:auto;border:1px solid var(--border);border-radius:8px;margin:10px 0;}
.preview-table-wrap table{font-size:12px;}
.preview-table-wrap th{background:#f3f4f6;padding:6px 10px;font-size:11px;}
.preview-table-wrap td{padding:6px 10px;}
.upload-info{font-size:13px;color:var(--green);font-weight:600;margin-bottom:10px;}
.col-map{background:var(--blue-lt);border-radius:8px;padding:12px;margin:10px 0;font-size:13px;}
.col-map strong{display:block;margin-bottom:8px;color:var(--blue);}
.col-map-row{display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap;}
.col-map-row label{font-weight:600;min-width:110px;font-size:12px;}
.col-map-row select{min-width:160px;padding:5px 10px;font-size:12px;}

/* ── Password Modal ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:var(--white);border-radius:16px;padding:32px;width:100%;max-width:380px;box-shadow:var(--shadow-lg);text-align:center;}
.modal .lock-icon{font-size:40px;margin-bottom:12px;}
.modal h3{font-size:20px;font-weight:700;margin-bottom:6px;}
.modal p{font-size:14px;color:var(--muted);margin-bottom:20px;}
.modal input{width:100%;padding:11px 14px;border:1px solid var(--border);border-radius:8px;font-size:15px;margin-bottom:10px;outline:none;text-align:center;letter-spacing:2px;}
.modal input:focus{border-color:var(--blue);}
.modal .btn{width:100%;justify-content:center;margin-bottom:8px;}
.modal-error{color:var(--red);font-size:13px;font-weight:600;display:none;margin-bottom:8px;}

/* ── Toast ── */
.toast{position:fixed;bottom:24px;right:24px;background:#1f2937;color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:600;z-index:2000;transform:translateY(80px);opacity:0;transition:all .3s;max-width:320px;}
.toast.show{transform:translateY(0);opacity:1;}
.toast.success{background:var(--green);}
.toast.error{background:var(--red);}

/* ── Save bar ── */
.save-bar{display:none;position:sticky;bottom:0;background:linear-gradient(135deg,#1a56db,#7c3aed);padding:12px 32px;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;z-index:100;}
.editor-active .save-bar{display:flex;}
.save-bar p{color:#fff;font-size:13px;font-weight:600;}
.save-bar small{display:block;font-weight:400;opacity:.8;font-size:11px;margin-top:2px;}
.btn-save{background:#fff;color:var(--blue);font-weight:700;border:none;padding:10px 20px;border-radius:8px;font-size:14px;cursor:pointer;display:flex;align-items:center;gap:7px;}
.btn-save:hover{background:#e8eeff;}

@media(max-width:640px){
  header,.toolbar,.stats,.table-wrap,.editor-panel{padding-left:16px;padding-right:16px;}
  .table-wrap,.editor-panel{margin-left:16px;margin-right:16px;}
  th,td{padding:9px 10px;}
  .form-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<!-- ══════════════ PASSWORD MODAL ══════════════ -->
<div class="modal-overlay" id="loginModal">
  <div class="modal">
    <div class="lock-icon">🔐</div>
    <h3>Editor Login</h3>
    <p>Enter the editor password to add or modify products</p>
    <input type="password" id="pwInput" placeholder="Password" onkeydown="if(event.key==='Enter')doLogin()"/>
    <div class="modal-error" id="pwError">Incorrect password. Try again.</div>
    <button class="btn btn-blue" onclick="doLogin()">Login</button>
    <button class="btn btn-cancel" onclick="closeLogin()">Cancel</button>
  </div>
</div>

<!-- ══════════════ HEADER ══════════════ -->
<header>
  <div class="brand">
    <div class="logo">ST</div>
    <div>
      <h1>Master Price List</h1>
      <p>Supertek &nbsp;·&nbsp; Internal Reference</p>
    </div>
  </div>
  <div class="header-right">
    <span class="badge" id="lastBadge">—</span>
    <button class="btn-editor-login" onclick="openLogin()">🔐 Editor Login</button>
    <button class="btn-editor-logout" onclick="doLogout()">🚪 Logout</button>
  </div>
</header>

<!-- Editor active banner -->
<div class="editor-banner">
  <div class="dot"></div>
  Editor Mode Active — You can add, edit and delete products below
</div>

<!-- ══════════════ TOOLBAR ══════════════ -->
<div class="toolbar">
  <div class="search-wrap">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" id="searchBox" placeholder="Search name, SKU, brand…" oninput="renderTable()"/>
  </div>
  <select id="catFilter" onchange="renderTable()"><option value="">All Categories</option></select>
  <select id="brandFilter" onchange="renderTable()"><option value="">All Brands</option></select>
  <button class="btn btn-green" onclick="exportExcel()">
    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    Download Excel
  </button>
</div>

<!-- Stats -->
<div class="stats">
  <div class="stat"><span class="stat-label">Total Products</span><span class="stat-value" id="statTotal">—</span><span class="stat-sub">in master list</span></div>
  <div class="stat"><span class="stat-label">Showing</span><span class="stat-value" id="statShowing">—</span><span class="stat-sub">after filter</span></div>
  <div class="stat"><span class="stat-label">Categories</span><span class="stat-value" id="statCats">—</span><span class="stat-sub">product groups</span></div>
  <div class="stat"><span class="stat-label">Brands</span><span class="stat-value" id="statBrands">—</span><span class="stat-sub">suppliers</span></div>
</div>

<!-- ══════════════ EDITOR PANEL ══════════════ -->
<div class="editor-panel">
  <div class="ep-header">
    <h3>✏️ Product Editor</h3>
    <span style="font-size:12px;opacity:.8;">Changes are saved when you click Save & Download below</span>
  </div>
  <div class="ep-tabs">
    <button class="ep-tab active" onclick="switchTab('add')">➕ Add Product</button>
    <button class="ep-tab" onclick="switchTab('upload')">📤 Upload Excel</button>
  </div>
  <div class="ep-body">

    <!-- ADD / EDIT PRODUCT -->
    <div class="ep-section active" id="tabAdd">
      <div id="editNote">✏️ Editing existing product — make changes and click Update Product</div>
      <div class="form-grid">
        <div class="form-group"><label>SKU / Code *</label><input type="text" id="fSku" placeholder="e.g. ST-031"/></div>
        <div class="form-group"><label>Product Name *</label><input type="text" id="fName" placeholder="e.g. LED Bulb 9W"/></div>
        <div class="form-group">
          <label>Category *</label>
          <input type="text" id="fCat" list="catList" placeholder="e.g. Lighting"/>
          <datalist id="catList"></datalist>
        </div>
        <div class="form-group">
          <label>Brand</label>
          <input type="text" id="fBrand" list="brandList" placeholder="e.g. Philips"/>
          <datalist id="brandList"></datalist>
        </div>
        <div class="form-group"><label>Cost Price (₹) *</label><input type="number" id="fPrice" placeholder="e.g. 299.00" step="0.01" min="0"/></div>
      </div>
      <div class="form-actions">
        <button class="btn btn-blue btn-sm" onclick="submitProduct()" id="submitBtn">➕ Add Product</button>
        <button class="btn btn-cancel btn-sm" onclick="clearForm()" id="cancelBtn" style="display:none">✕ Cancel Edit</button>
      </div>
    </div>

    <!-- EXCEL UPLOAD -->
    <div class="ep-section" id="tabUpload">
      <div class="drop-zone" id="dropZone" onclick="document.getElementById('xlFile').click()" ondragover="doDragOver(event)" ondragleave="doDragLeave(event)" ondrop="doDrop(event)">
        <input type="file" id="xlFile" accept=".xlsx,.xls,.csv" onchange="handleFileSelect(event)"/>
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <h4>Drop Excel or CSV file here</h4>
        <p>Click to browse &nbsp;·&nbsp; Supports .xlsx .xls .csv</p>
      </div>

      <div class="upload-preview" id="uploadPreview">
        <p class="upload-info" id="uploadInfo"></p>

        <div class="col-map" id="colMap">
          <strong>📋 Map your columns:</strong>
          <div class="col-map-row"><label>SKU / Code</label><select id="mapSku"></select></div>
          <div class="col-map-row"><label>Product Name</label><select id="mapName"></select></div>
          <div class="col-map-row"><label>Category</label><select id="mapCat"></select></div>
          <div class="col-map-row"><label>Brand</label><select id="mapBrand"></select></div>
          <div class="col-map-row"><label>Cost Price</label><select id="mapPrice"></select></div>
        </div>

        <div class="preview-table-wrap" id="previewTableWrap"></div>

        <div class="form-actions" style="margin-top:10px;">
          <button class="btn btn-blue btn-sm" onclick="importFromExcel()">✅ Import All Rows</button>
          <button class="btn btn-cancel btn-sm" onclick="clearUpload()">✕ Clear</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ══════════════ PRICE TABLE ══════════════ -->
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th onclick="sortBy('sku')"       data-col="sku">SKU / Code</th>
        <th onclick="sortBy('name')"      data-col="name">Product Name</th>
        <th onclick="sortBy('category')"  data-col="category">Category</th>
        <th onclick="sortBy('brand')"     data-col="brand">Brand</th>
        <th onclick="sortBy('costPrice')" data-col="costPrice">Cost Price ₹</th>
        <th class="action-btns" style="display:none" id="actionHead">Actions</th>
      </tr>
    </thead>
    <tbody id="tableBody"></tbody>
  </table>
  <div class="tfoot-bar">
    <span id="footerCount">Loading…</span>
    <span>Supertek Internal — Do not distribute externally</span>
  </div>
</div>

<!-- ══════════════ SAVE BAR ══════════════ -->
<div class="save-bar">
  <div>
    <p>💾 Ready to save your changes?</p>
    <small>Click Save & Download → upload the new index.html to GitHub → done!</small>
  </div>
  <button class="btn-save" onclick="saveAndDownload()">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    Save & Download index.html
  </button>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
// ═══════════════════════════════════════════════
//  !! CHANGE PASSWORD HERE !!
// ═══════════════════════════════════════════════
const EDITOR_PASSWORD = "supertek@2024";

// ═══════════════════════════════════════════════
