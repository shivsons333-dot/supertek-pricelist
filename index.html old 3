// ══ State ══
let sortCol = 'name', sortDir = 1;
let editIdx = -1;         // index in PRODUCTS being edited (-1 = add mode)
let uploadRows = [];      // parsed rows from Excel upload
let isEditor = false;

// ══ Init ══
function init(){
  buildDropdowns();
  renderTable();
  const d = new Date();
  document.getElementById('lastBadge').textContent = 'Updated ' + d.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
}

// ══ Dropdowns ══
function buildDropdowns(){
  const cats   = [...new Set(PRODUCTS.map(r=>r.category).filter(Boolean))].sort();
  const brands = [...new Set(PRODUCTS.map(r=>r.brand).filter(Boolean))].sort();
  const catSel   = document.getElementById('catFilter');
  const brandSel = document.getElementById('brandFilter');
  // reset
  catSel.innerHTML  = '<option value="">All Categories</option>';
  brandSel.innerHTML= '<option value="">All Brands</option>';
  cats.forEach(c   => catSel.add(new Option(c,c)));
  brands.forEach(b => brandSel.add(new Option(b,b)));
  // datalists for form
  const cl = document.getElementById('catList');
  const bl = document.getElementById('brandList');
  cl.innerHTML = ''; bl.innerHTML = '';
  cats.forEach(c   => { const o=document.createElement('option'); o.value=c; cl.appendChild(o); });
  brands.forEach(b => { const o=document.createElement('option'); o.value=b; bl.appendChild(o); });
  document.getElementById('statTotal').textContent = PRODUCTS.length;
  document.getElementById('statCats').textContent  = cats.length;
  document.getElementById('statBrands').textContent= brands.length;
}

// ══ Render Table ══
function renderTable(){
  const q     = (document.getElementById('searchBox').value||'').toLowerCase();
  const cat   = document.getElementById('catFilter').value;
  const brand = document.getElementById('brandFilter').value;

  let rows = PRODUCTS.filter((r,i)=>{
    r._idx = i;
    const match = !q || [r.sku,r.name,r.category,r.brand].some(v=>(v||'').toLowerCase().includes(q));
    return match && (!cat||r.category===cat) && (!brand||r.brand===brand);
  });

  rows.sort((a,b)=>{
    const va=a[sortCol]||'', vb=b[sortCol]||'';
    if(sortCol==='costPrice') return ((+va)-(+vb))*sortDir;
    return va.localeCompare(vb)*sortDir;
  });

  const tbody = document.getElementById('tableBody');
  if(!rows.length){
    tbody.innerHTML = `<tr><td colspan="6" class="no-data">No products match your filter.</td></tr>`;
  } else {
    tbody.innerHTML = rows.map(r=>`
      <tr>
        <td><span class="sku">${esc(r.sku||'—')}</span></td>
        <td><strong>${esc(r.name||'—')}</strong></td>
        <td><span class="cat-badge">${esc(r.category||'—')}</span></td>
        <td>${esc(r.brand||'—')}</td>
        <td class="price">₹ ${fmt(r.costPrice)}</td>
        <td class="action-btns" style="${isEditor?'display:flex':'display:none'}">
          <button class="btn-edit-row" onclick="startEdit(${r._idx})">✏️ Edit</button>
          <button class="btn-del-row"  onclick="deleteProduct(${r._idx})">🗑 Delete</button>
        </td>
      </tr>`).join('');
  }

  // Show/hide action column header
  document.getElementById('actionHead').style.display = isEditor ? 'table-cell' : 'none';
  document.getElementById('statShowing').textContent = rows.length;
  document.getElementById('footerCount').textContent = `Showing ${rows.length} of ${PRODUCTS.length} products`;

  // Sort indicators
  document.querySelectorAll('th[data-col]').forEach(th=>{
    th.classList.remove('asc','desc');
    if(th.dataset.col===sortCol) th.classList.add(sortDir===1?'asc':'desc');
  });
}

function sortBy(col){
  if(sortCol===col) sortDir=-sortDir; else {sortCol=col; sortDir=1;}
  renderTable();
}

// ══ Login / Logout ══
function openLogin(){ document.getElementById('loginModal').classList.add('open'); document.getElementById('pwInput').focus(); }
function closeLogin(){ document.getElementById('loginModal').classList.remove('open'); document.getElementById('pwInput').value=''; document.getElementById('pwError').style.display='none'; }
function doLogin(){
  const pw = document.getElementById('pwInput').value;
  if(pw === EDITOR_PASSWORD){
    isEditor = true;
    document.body.classList.add('editor-active');
    closeLogin();
    renderTable();
    toast('Editor mode active. Add or edit products below.','success');
  } else {
    document.getElementById('pwError').style.display='block';
    document.getElementById('pwInput').value='';
    document.getElementById('pwInput').focus();
  }
}
function doLogout(){
  isEditor = false;
  document.body.classList.remove('editor-active');
  clearForm();
  renderTable();
  toast('Logged out of editor mode.');
}

// ══ Add / Edit Product ══
function submitProduct(){
  const sku   = document.getElementById('fSku').value.trim();
  const name  = document.getElementById('fName').value.trim();
  const cat   = document.getElementById('fCat').value.trim();
  const brand = document.getElementById('fBrand').value.trim();
  const price = parseFloat(document.getElementById('fPrice').value);

  if(!sku||!name||!cat||isNaN(price)){
    toast('Please fill SKU, Name, Category and Cost Price.','error');
    return;
  }

  if(editIdx === -1){
    // Add new
    if(PRODUCTS.some(p=>p.sku.toLowerCase()===sku.toLowerCase())){
      toast('A product with this SKU already exists.','error'); return;
    }
    PRODUCTS.push({sku,name,category:cat,brand,costPrice:price});
    toast(`✅ "${name}" added successfully!`,'success');
  } else {
    // Update existing
    PRODUCTS[editIdx] = {sku,name,category:cat,brand,costPrice:price};
    toast(`✅ "${name}" updated!`,'success');
  }
  clearForm();
  buildDropdowns();
  renderTable();
}

function startEdit(idx){
  editIdx = idx;
  const p = PRODUCTS[idx];
  document.getElementById('fSku').value   = p.sku;
  document.getElementById('fName').value  = p.name;
  document.getElementById('fCat').value   = p.category;
  document.getElementById('fBrand').value = p.brand;
  document.getElementById('fPrice').value = p.costPrice;
  document.getElementById('editNote').style.display='block';
  document.getElementById('submitBtn').textContent='💾 Update Product';
  document.getElementById('cancelBtn').style.display='inline-flex';
  switchTab('add');
  document.querySelector('.editor-panel').scrollIntoView({behavior:'smooth',block:'start'});
}

function deleteProduct(idx){
  const p = PRODUCTS[idx];
  if(!confirm(`Delete "${p.name}"?\n\nThis cannot be undone until you cancel without saving.`)) return;
  PRODUCTS.splice(idx,1);
  buildDropdowns();
  renderTable();
  toast(`🗑 "${p.name}" removed.`,'success');
}

function clearForm(){
  editIdx = -1;
  ['fSku','fName','fCat','fBrand','fPrice'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('editNote').style.display='none';
  document.getElementById('submitBtn').textContent='➕ Add Product';
  document.getElementById('cancelBtn').style.display='none';
}

// ══ Tab switch ══
function switchTab(name){
  document.querySelectorAll('.ep-tab').forEach((t,i)=>{
    const names=['add','upload'];
    t.classList.toggle('active', names[i]===name);
  });
  document.querySelectorAll('.ep-section').forEach((s,i)=>{
    const names=['tabAdd','tabUpload'];
    s.classList.toggle('active', s.id===`tab${name.charAt(0).toUpperCase()+name.slice(1)}`);
  });
}

// ══ Excel Upload ══
function doDragOver(e){ e.preventDefault(); document.getElementById('dropZone').classList.add('drag-over'); }
function doDragLeave(e){ document.getElementById('dropZone').classList.remove('drag-over'); }
function doDrop(e){
  e.preventDefault();
  doDragLeave(e);
  const file = e.dataTransfer.files[0];
  if(file) processFile(file);
}
function handleFileSelect(e){ const file=e.target.files[0]; if(file) processFile(file); }

function processFile(file){
  const reader = new FileReader();
  reader.onload = function(e){
    let data;
    try{
      const wb = XLSX.read(e.target.result, {type:'array'});
      const ws = wb.Sheets[wb.SheetNames[0]];
      data = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
    } catch(err){ toast('Could not read file. Please use .xlsx, .xls or .csv','error'); return; }

    if(!data||data.length<2){ toast('File appears empty.','error'); return; }

    uploadRows = data;
    const headers = data[0].map(h=>String(h).trim());

    // Auto-map columns
    const maps = {mapSku:'mapSku',mapName:'mapName',mapCat:'mapCat',mapBrand:'mapBrand',mapPrice:'mapPrice'};
    const opts = ['(skip)', ...headers];
    Object.keys(maps).forEach(id=>{
      const sel = document.getElementById(id);
      sel.innerHTML = opts.map(o=>`<option>${o}</option>`).join('');
    });

    // smart auto-detect
    const guess = (keywords) => {
      const found = headers.find(h=>keywords.some(k=>h.toLowerCase().includes(k)));
      return found || '(skip)';
    };
    document.getElementById('mapSku').value   = guess(['sku','code','item code']);
    document.getElementById('mapName').value  = guess(['name','product','description','item name']);
    document.getElementById('mapCat').value   = guess(['category','cat','group','type']);
    document.getElementById('mapBrand').value = guess(['brand','make','manufacturer','company']);
    document.getElementById('mapPrice').value = guess(['cost','price','rate','purchase','amount']);

    // Preview table (first 5 data rows)
    const preview = data.slice(0,6);
    const tableHtml = `<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>
      ${preview.slice(1).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}
    </tbody></table>`;
    document.getElementById('previewTableWrap').innerHTML = tableHtml;
    document.getElementById('uploadInfo').textContent = `📄 ${file.name} — ${data.length-1} product rows found`;
    document.getElementById('uploadPreview').style.display='block';
  };
  reader.readAsArrayBuffer(file);
}

function importFromExcel(){
  if(!uploadRows.length){ toast('No file loaded.','error'); return; }
  const headers = uploadRows[0];
  const getCol = (selId) => {
    const val = document.getElementById(selId).value;
    if(val==='(skip)') return -1;
    return headers.indexOf(val);
  };
  const ci = {sku:getCol('mapSku'),name:getCol('mapName'),cat:getCol('mapCat'),brand:getCol('mapBrand'),price:getCol('mapPrice')};

  if(ci.name===-1||ci.price===-1){ toast('Please map at least Product Name and Cost Price.','error'); return; }

  let added=0, skipped=0;
  uploadRows.slice(1).forEach(row=>{
    const sku   = ci.sku>=0   ? String(row[ci.sku]||'').trim()   : '';
    const name  = ci.name>=0  ? String(row[ci.name]||'').trim()  : '';
    const cat   = ci.cat>=0   ? String(row[ci.cat]||'').trim()   : '';
    const brand = ci.brand>=0 ? String(row[ci.brand]||'').trim() : '';
    const price = parseFloat(String(row[ci.price]||'').replace(/[^0-9.]/g,''));
    if(!name||isNaN(price)){ skipped++; return; }
    // skip duplicate SKU
    if(sku && PRODUCTS.some(p=>p.sku.toLowerCase()===sku.toLowerCase())){ skipped++; return; }
    PRODUCTS.push({sku,name,category:cat,brand,costPrice:price});
    added++;
  });

  buildDropdowns();
  renderTable();
  clearUpload();
  toast(`✅ Imported ${added} products${skipped?' ('+skipped+' skipped)':''}!`,'success');
}

function clearUpload(){
  uploadRows=[];
  document.getElementById('uploadPreview').style.display='none';
  document.getElementById('xlFile').value='';
}

// ══ Export Excel ══
function exportExcel(){
  const q     = (document.getElementById('searchBox').value||'').toLowerCase();
  const cat   = document.getElementById('catFilter').value;
  const brand = document.getElementById('brandFilter').value;
  let rows = PRODUCTS.filter(r=>{
    const match=!q||[r.sku,r.name,r.category,r.brand].some(v=>(v||'').toLowerCase().includes(q));
    return match&&(!cat||r.category===cat)&&(!brand||r.brand===brand);
  });
  const data=[['SKU / Code','Product Name','Category','Brand','Cost Price (₹)']];
  rows.forEach(r=>data.push([r.sku,r.name,r.category,r.brand,+r.costPrice||0]));
  const ws=XLSX.utils.aoa_to_sheet(data);
  ws['!cols']=[12,35,18,18,14].map(w=>({wch:w}));
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Master Price List');
  XLSX.writeFile(wb,`Supertek_PriceList_${new Date().toISOString().slice(0,10)}.xlsx`);
}

// ══ Save & Download ══
function saveAndDownload(){
  if(!isEditor){ toast('Please login as editor first.','error'); return; }
  const productJSON = JSON.stringify(PRODUCTS, null, 2);
  // Replace the PRODUCTS array in this page's source
  const src = document.documentElement.outerHTML;
  const start = src.indexOf('let PRODUCTS = [');
  const end   = src.indexOf('];', start) + 2;
  if(start===-1||end<2){ toast('Could not locate data section. Please contact support.','error'); return; }
  const newSrc = src.slice(0, start) + 'let PRODUCTS = ' + productJSON + src.slice(end);
  const blob = new Blob([newSrc], {type:'text/html'});
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'index.html'; a.click();
  URL.revokeObjectURL(url);
  toast('✅ index.html downloaded! Upload it to GitHub to publish changes.','success');
}

// ══ Helpers ══
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function fmt(v){ const n=parseFloat(v); if(isNaN(n)) return '—'; return n.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function toast(msg, type=''){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className='toast'+(type?' '+type:'');
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),3500);
}

init();
